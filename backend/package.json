{
  "name": "delivery-app-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express + MongoDB API (REST + socket.io) for the delivery app",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "backfill:customers": "node scripts/backfillStoreCustomers.mjs",
    "test:smoke": "node scripts/smokeTest.mjs",
    "test:cache": "node scripts/testStorefrontCache.mjs",
    "test:compression": "node scripts/testCompression.mjs",
    "test:images": "node scripts/testCloudinary.mjs",
    "test:images:why": "node scripts/diagnoseCloudinary.mjs",
    "test:credentials": "node scripts/testCredentialsFromUrl.mjs",
    "images:inventory": "node scripts/cloudinaryInventory.mjs",
    "backfill:images": "node scripts/backfillImages.mjs",
    "test:variants": "node scripts/testVariants.mjs && node scripts/testProductModel.mjs && node scripts/testVariantParity.mjs",
    "test:variants:db": "node scripts/testVariantIntegration.mjs",
    "test:categories": "node scripts/testCategories.mjs",
    "test:categories:clean": "node scripts/cleanupTestCategories.mjs",
    "test:tree": "node scripts/testCategoryTree.mjs",
    "test:theme2": "node scripts/testTheme2.mjs",
    "test:logo": "node scripts/testLogoSize.mjs",
    "test:slug": "node scripts/testStoreSlug.mjs",
    "verify:slug": "node scripts/verifySlugRename.mjs",
    "test:filing": "node scripts/testProductFiling.mjs",
    "test:sections": "node scripts/testSections.mjs",
    "test:card": "node scripts/testProductCardFit.mjs",
    "test:bulk": "node scripts/testBulkEdit.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "socket.io": "^4.8.3",
    "sslcommerz-lts": "^1.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
