# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your machine.
# This file is read by src/config/env.js at boot time.
# ---------------------------------------------------------------------------

# Port the API + socket.io server listens on. The client expects 5000
# (see client/.env -> VITE_API_URL=http://localhost:5000/api).
PORT=5000

# MongoDB connection string.
#
# Local server without auth:
#   MONGO_URI=mongodb://127.0.0.1:27017/delivery_app
#
# MongoDB Atlas (remember the database name before the "?"):
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/delivery_app?retryWrites=true&w=majority&appName=<app>
#
# The part between the last "/" and the "?" is the database name. Leaving it
# out makes Mongoose use a database called "test".
#
# NOTE: never commit real credentials here - this file is tracked by git.
# Put the real connection string in `.env` (which is git-ignored).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/delivery_app?retryWrites=true&w=majority&appName=<app>

# Optional. Only needed when a mongodb+srv:// URL fails with:
#   querySrv ECONNREFUSED _mongodb._tcp.<cluster>.mongodb.net
# That means your router/VPN refuses SRV lookups; these public resolvers do
# answer them. Leave empty to use your operating system's DNS.
MONGO_DNS_SERVERS=

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# How long a login stays valid. Examples: 1h, 7d, 30d
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call the API.
# The Vite dev server runs on 5173.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Create the demo accounts + sample products automatically on every boot.
# Handy in development; turn it off in production.
AUTO_SEED=true