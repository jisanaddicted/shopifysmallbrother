# Monorepo-wide ignores. Each package also has its own .gitignore.

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Local environment files (keep .env.example committed!)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Local runtime files (PIDs written when starting the backend / cloudflared tunnel)
.cf-*.pid

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.local