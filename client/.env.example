# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your machine.
# Vite only exposes variables that start with VITE_ to the browser code.
# Never put secrets (DB passwords, private API keys) in here - everything
# with a VITE_ prefix is shipped to the client bundle.
# ---------------------------------------------------------------------------

# Base URL of the REST API (usually an Express server).
VITE_API_URL=http://localhost:5000/api

# Base URL of the socket.io server (no /api suffix).
VITE_SOCKET_URL=http://localhost:5000

# Currency + locale used by src/utils/formatters.js
# Examples: USD, EUR, GBP, INR, NPR, AED, PKR
VITE_DEFAULT_CURRENCY=USD
VITE_DEFAULT_LOCALE=en-US
