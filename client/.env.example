# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your machine.
# Vite only exposes variables that start with VITE_ to the browser code.
# Never put secrets (DB passwords, private API keys) in here - everything
# with a VITE_ prefix is shipped to the client bundle.
# ---------------------------------------------------------------------------

# Base URL of the REST API.
# Local dev: your backend's address. For a production build served BY the
# backend use `/api` instead - see client/.env.production, which overrides this
# file automatically during `npm run build`.
VITE_API_URL=http://localhost:5000/api

# Base URL of the socket.io server (no /api suffix).
# Production builds use `/` (= same origin as the page): see .env.production.
VITE_SOCKET_URL=http://localhost:5000

# NOTE: never set these from the command line with `set VAR=value && ...` in
# cmd.exe - the space before `&&` becomes part of the value ("/api "), and every
# request then turns into /api%20/auth/login -> "Route not found".

# Currency + locale used by src/utils/formatters.js
# Examples: USD, EUR, GBP, INR, NPR, AED, PKR
VITE_DEFAULT_CURRENCY=USD
VITE_DEFAULT_LOCALE=en-US
