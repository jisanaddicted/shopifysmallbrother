# Production build values - loaded by Vite for `npm run build` (mode=production)
# and they OVERRIDE client/.env, so the deployed bundle never hardcodes
# localhost. No secrets belong here; everything VITE_* ships in the bundle.
#
# Why same-origin: the backend serves client/dist itself (see
# backend/src/app.js), so one Cloudflare tunnel URL serves both the app and the
# API. "/api" resolves against window.location.origin
# (see src/utils/constants.js), which is what makes the phone work remotely.
#
# Do NOT set these from the command line with `set VAR=value && ...` in
# cmd.exe - the space before `&&` ends up inside the value ("/api ") and every
# request turns into /api%20/auth/login.

# Base URL of the REST API.
VITE_API_URL=/api

# Base URL of the socket.io server - "/" = same origin as the page.
VITE_SOCKET_URL=/

# Money. These MUST be repeated here, not just in client/.env: this file
# overrides .env for every production build, and formatCurrency() falls back to
# 'USD'/'en-US' when the variables are missing - a tunnel build would show "$".
# 'narrowSymbol' in utils/formatters.js renders BDT as the real sign (৳).
VITE_DEFAULT_CURRENCY=BDT
VITE_DEFAULT_LOCALE=en-BD
